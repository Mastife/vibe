{
  "name": "@projects-hq/backend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun run prisma:generate && bun --watch src/index.ts",
    "start": "bun run start:api",
    "start:api": "bun run prisma:generate && bun src/index.ts",
    "start:worker": "bun run prisma:generate && bun src/worker.ts",
    "start:cron": "bun run prisma:generate && bun src/cron.ts",
    "start:raw": "bun src/index.ts",
    "build": "bun run prisma:generate && tsc --noEmit",
    "typecheck": "bun run prisma:generate && tsc --noEmit",
    "test": "bun run test:unit && bun run test:integration",
    "test:unit": "bun test src/env.test.ts src/db.test.ts src/contracts.test.ts src/cron.test.ts src/worker.test.ts src/lib src/auth/access-tokens.test.ts src/auth/passwords.test.ts src/auth/refresh-tokens.test.ts src/auth/routes.test.ts src/storage/service.test.ts src/health/checker.test.ts src/notifications src/github src/dashboard/alerts.test.ts src/dashboard/analytics.test.ts src/health/transition.test.ts src/health/docker-checker.test.ts src/health/target.test.ts src/health/notify.test.ts src/projects/pilot.test.ts src/invoices/billing.test.ts src/domains/service.test.ts",
    "test:integration": "bun scripts/test-integration.mjs",
    "smoke:docker": "bun scripts/docker-smoke.mjs",
    "prisma": "prisma",
    "prisma:generate": "bun scripts/prisma-generate.mjs",
    "prisma:generate:raw": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:validate": "prisma validate",
    "dev:worker": "bun run prisma:generate && bun --watch src/worker.ts",
    "seed": "bun run prisma:generate && bun scripts/seed.ts",
    "db:reset:test": "bun scripts/reset-test-db.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1048.0",
    "@aws-sdk/s3-request-presigner": "^3.1048.0",
    "@hono/zod-openapi": "^1.4.0",
    "@hono/zod-validator": "^0.8.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@projects-hq/contracts": "workspace:*",
    "dotenv": "^17.4.2",
    "hono": "^4.12.19",
    "jose": "^6.2.3",
    "pg": "^8.20.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/pg": "^8.20.0",
    "prisma": "^7.8.0",
    "typescript": "~6.0.3"
  }
}
