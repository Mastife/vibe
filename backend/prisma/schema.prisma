generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  email        String        @unique
  passwordHash String        @map("password_hash")
  displayName  String?       @map("display_name")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  sessions     AuthSession[]

  @@map("users")
}

model AuthSession {
  id               String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @unique(map: "auth_sessions_refresh_token_hash_key") @map("refresh_token_hash")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  userAgent        String?   @map("user_agent")
  ipAddress        String?   @map("ip_address")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade, map: "auth_sessions_user_id_fkey")

  @@index([userId], map: "auth_sessions_user_id_idx")
  @@index([expiresAt], map: "auth_sessions_expires_at_idx")
  @@map("auth_sessions")
}

/// What the client decided after the pilot; null while the decision is still open.
enum PilotOutcome {
  CONTINUE
  DECLINE
}

enum ProjectStatus {
  DEVELOPMENT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum HealthStatus {
  UP
  DOWN
  UNKNOWN
}

enum ServerStatus {
  ACTIVE
  SUSPENDED
  DECOMMISSIONED
}

enum BillingPeriod {
  MONTHLY
  QUARTERLY
  YEARLY
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  CANCELLED
}

model Client {
  id          String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name        String
  contactName String?   @map("contact_name")
  email       String?
  phone       String?
  telegram    String?
  notes       String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  projects    Project[]
  invoices    Invoice[]

  @@map("clients")
}

model Server {
  id            String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name          String
  provider      String?
  host          String?
  location      String?
  specs         String?
  panelUrl      String?         @map("panel_url")
  monthlyCost   Decimal         @default(0) @map("monthly_cost") @db.Decimal(14, 2)
  currency      String          @default("KZT")
  billingPeriod BillingPeriod   @default(MONTHLY) @map("billing_period")
  paidUntil     DateTime?       @map("paid_until") @db.Date
  status        ServerStatus    @default(ACTIVE)
  notes         String?
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  projects      Project[]
  payments      ServerPayment[]

  @@index([paidUntil])
  @@map("servers")
}

model ServerPayment {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  serverId    String   @map("server_id") @db.Uuid
  amount      Decimal  @db.Decimal(14, 2)
  currency    String
  paidAt      DateTime @map("paid_at") @db.Date
  periodStart DateTime @map("period_start") @db.Date
  periodEnd   DateTime @map("period_end") @db.Date
  note        String?
  createdAt   DateTime @default(now()) @map("created_at")
  server      Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId, paidAt])
  @@map("server_payments")
}

model Project {
  id                  String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name                String
  slug                String           @unique
  description         String?
  status              ProjectStatus    @default(ACTIVE)
  repoUrl             String?          @map("repo_url")
  productionUrl       String?          @map("production_url")
  healthCheckUrl      String?          @map("health_check_url")
  clientId            String?          @map("client_id") @db.Uuid
  serverId            String?          @map("server_id") @db.Uuid
  monthlyFee          Decimal?         @map("monthly_fee") @db.Decimal(14, 2)
  currency            String           @default("KZT")
  tags                String[]         @default([])
  notes               String?
  /// Issue a monthly subscription invoice to the client on `billingDay` (1-28).
  autoInvoice         Boolean          @default(false) @map("auto_invoice")
  billingDay          Int              @default(1) @map("billing_day")
  /// Pilot period agreed with the client; reminders fire before `pilotEndsAt` until an outcome is set.
  pilotStartsAt       DateTime?        @map("pilot_starts_at") @db.Date
  pilotEndsAt         DateTime?        @map("pilot_ends_at") @db.Date
  pilotOutcome        PilotOutcome?    @map("pilot_outcome")
  lastHealthStatus    HealthStatus     @default(UNKNOWN) @map("last_health_status")
  lastCheckedAt       DateTime?        @map("last_checked_at")
  lastLatencyMs       Int?             @map("last_latency_ms")
  lastStatusCode      Int?             @map("last_status_code")
  lastError           String?          @map("last_error")
  /// Failed checks in a row; the project is only marked DOWN once this reaches HEALTH_DOWN_AFTER_FAILURES.
  consecutiveFailures Int              @default(0) @map("consecutive_failures")
  sslExpiresAt        DateTime?        @map("ssl_expires_at")
  repoPushedAt        DateTime?        @map("repo_pushed_at")
  repoOpenIssues      Int?             @map("repo_open_issues")
  repoSyncedAt        DateTime?        @map("repo_synced_at")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")
  client              Client?          @relation(fields: [clientId], references: [id], onDelete: SetNull)
  server              Server?          @relation(fields: [serverId], references: [id], onDelete: SetNull)
  healthRuns          HealthCheckRun[]
  invoices            Invoice[]
  domains             Domain[]

  @@index([clientId])
  @@index([serverId])
  @@index([status])
  @@map("projects")
}

model HealthCheckRun {
  id           String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  projectId    String    @map("project_id") @db.Uuid
  checkedAt    DateTime  @default(now()) @map("checked_at")
  ok           Boolean
  statusCode   Int?      @map("status_code")
  latencyMs    Int?      @map("latency_ms")
  error        String?
  sslExpiresAt DateTime? @map("ssl_expires_at")
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, checkedAt])
  @@index([checkedAt])
  @@map("health_check_runs")
}

model Invoice {
  id         String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  clientId   String        @map("client_id") @db.Uuid
  projectId  String?       @map("project_id") @db.Uuid
  title      String
  amount     Decimal       @db.Decimal(14, 2)
  currency   String        @default("KZT")
  status     InvoiceStatus @default(SENT)
  issuedAt   DateTime      @map("issued_at") @db.Date
  dueAt      DateTime?     @map("due_at") @db.Date
  paidAt     DateTime?     @map("paid_at") @db.Date
  note       String?
  /// `YYYY-MM` of an automatically issued subscription invoice; one per project and month.
  autoPeriod String?       @map("auto_period")
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")
  client     Client        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  project    Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@unique([projectId, autoPeriod])
  @@index([clientId])
  @@index([projectId])
  @@index([status, dueAt])
  @@map("invoices")
}

model Domain {
  id             String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name           String    @unique
  registrar      String?
  projectId      String?   @map("project_id") @db.Uuid
  expiresAt      DateTime? @map("expires_at") @db.Date
  renewalCost    Decimal   @default(0) @map("renewal_cost") @db.Decimal(14, 2)
  currency       String    @default("KZT")
  notes          String?
  /// Last successful RDAP lookup of the expiry date.
  expirySyncedAt DateTime? @map("expiry_synced_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  project        Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([expiresAt])
  @@map("domains")
}

/// One row per Telegram payment reminder already sent, so each threshold fires once per due date.
model ReminderLog {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  kind      String
  entityId  String   @map("entity_id") @db.Uuid
  dueAt     DateTime @map("due_at") @db.Date
  threshold Int
  sentAt    DateTime @default(now()) @map("sent_at")

  @@unique([kind, entityId, dueAt, threshold])
  @@map("reminder_log")
}
