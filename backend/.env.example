# Local PostgreSQL from ../docker-compose.yml.
# Keep an explicit username and password in Prisma URLs even on local machines.
# Peer-auth style URLs without a user can produce opaque Prisma schema-engine errors.
DATABASE_URL="postgresql://superuser:superpassword@localhost:54329/projects_hq?schema=public"

# Test PostgreSQL from ../docker-compose.yml. Backend integration, Docker smoke,
# and Playwright E2E use this shape and must target the *_test database.
TEST_DATABASE_URL="postgresql://superuser:superpassword@localhost:54330/projects_hq_test?schema=public"

JWT_SECRET="replace-with-at-least-32-random-characters"
CORS_ORIGINS="http://localhost:5173,http://localhost:8081,http://localhost:19006"
ACCESS_TOKEN_TTL_SECONDS="900"
REFRESH_TOKEN_TTL_DAYS="30"
COOKIE_SECURE="false"

# Optional DigitalOcean Spaces storage. Leave blank until the product needs
# uploads, media, or other persistent files.
SPACES_REGION=""
SPACES_BUCKET=""
SPACES_ENDPOINT=""
SPACES_CDN_BASE_URL=""
SPACES_ACCESS_KEY_ID=""
SPACES_SECRET_ACCESS_KEY=""
SPACES_UPLOAD_MAX_BYTES="10485760"
SPACES_UPLOAD_URL_TTL_SECONDS="900"
SPACES_DOWNLOAD_URL_TTL_SECONDS="300"
SPACES_PUBLIC_CACHE_CONTROL="public, max-age=31536000, immutable"

# Admin panel settings. The first registered account becomes the admin and
# registration closes; ADMIN_EMAILS lists extra emails that may still register.
ADMIN_EMAILS=""
# Public URL of the web panel, used in Telegram notifications.
APP_URL=""

# Availability monitoring (worker: `bun run start:worker`, or cron task health:check).
HEALTH_CHECK_INTERVAL_SECONDS="300"
HEALTH_CHECK_TIMEOUT_MS="10000"
HEALTH_HISTORY_RETENTION_DAYS="30"

# Optional GitHub token (repo read scope) for last-push and open-issue counters.
GITHUB_TOKEN=""
GITHUB_SYNC_INTERVAL_SECONDS="3600"

# Optional Telegram alerts (downtime/recovery + daily digest). Set both or neither.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
DAILY_DIGEST_HOUR_UTC="6"

# Payment term (days) of automatically issued monthly subscription invoices.
INVOICE_DUE_DAYS="10"
